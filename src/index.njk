---
layout: layouts/base.njk
isHome: true
---
{% from "photo.njk" import photo %}
<section class="foreword" id="foreword" aria-labelledby="foreword-title">
  <div class="foreword-copy">
    <p class="eyebrow">A note from the kitchen</p>
    <h1 id="foreword-title">Good food,<br><em>worth keeping</em></h1>
    <a href="/recipes/" class="text-link">Find something to cook <span aria-hidden="true">↗</span></a>
  </div>
  {% set featured = collections.recipes[0] %}
  {% if featured %}
  <div class="featured-recipe">
    <a href="{{ featured.url }}" class="featured-link">
      {% if featured.data.image %}{{ photo(featured.data, 'featured-image', true) }}{% endif %}
      <div class="featured-caption"><span class="eyebrow">On the table</span><span>{% if featured.data.placeholder %}Recipe to come{% else %}{{ featured.data.totalMinutes }} minutes{% endif %}</span></div>
      <h2>{{ featured.data.title }}</h2>
      {% if featured.data.example %}<span class="sample-label">Sample recipe</span>{% endif %}
    </a>
  </div>
  {% endif %}
</section>
<section class="browse-strip" aria-label="Browse the collection">
  <a href="/ingredients/"><span class="eyebrow">Start with what you have</span><span class="browse-title">By ingredient <span aria-hidden="true">↗</span></span></a>
  <a href="/occasions/"><span class="eyebrow">For whatever the day brings</span><span class="browse-title">By occasion <span aria-hidden="true">↗</span></span></a>
</section>
