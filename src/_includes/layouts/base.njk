<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  {% if not site.url or example or placeholder or noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  {% if site.url %}<link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">{% endif %}
  <meta name="theme-color" content="#f8f6f0">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/style.css">
  {% block head %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-shell">
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="{{ site.name }} — home">{{ site.name }}<span class="wordmark-dot">.</span></a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="/recipes/" {% if section == 'recipes' %}aria-current="{% if page.url == '/recipes/' %}page{% else %}true{% endif %}"{% endif %}>Recipes</a>
        <a href="/ingredients/" {% if section == 'ingredients' %}aria-current="{% if page.url == '/ingredients/' %}page{% else %}true{% endif %}"{% endif %}>Ingredients</a>
        <a href="/occasions/" {% if section == 'occasions' %}aria-current="{% if page.url == '/occasions/' %}page{% else %}true{% endif %}"{% endif %}>Occasions</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">{{ content | safe }}</main>
    <footer class="site-footer">
      <a class="footer-wordmark" href="/">{{ site.name }}.</a>
      <p>A little collection, always growing.</p>
      <a href="/#foreword">A note from the kitchen</a>
    </footer>
  </div>
</body>
</html>
